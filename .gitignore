# build output
/bin/
*.test
*.out

# local scratch (overlay upper/work, rootfs staging) — never commit
/scratch/
/test/rootfs/
/.spike/

# agent tooling state — worktrees live under here as nested checkouts, and a
# stray `git add -A` otherwise commits them as gitlinks
/.claude/

# editor / OS
.DS_Store

# build artifacts from `go build ./cmd/...` without -o — one line per cmd/, because
# the name is the package name and an unlisted one lands untracked at the repo root
/sandboxd
/orchestrator
/khora
/gateway
/openapigen

# Substrate run records are TRACKED, in docs/substrate-runs/ — an untracked record is
# one nothing can keep honest, and /.substrate-run.log rotted into a false EXIT=0 claim
# here precisely because nothing could see it. scripts/check-substrate-coverage.sh has
# to read the record in a fresh CI checkout, so it cannot be ignored. This line stays
# only so a stray local run does not land untracked.
/.substrate-run.log

# build output
/bin/
*.test
*.out

# local scratch — never commit. Two unrelated kinds of thing live here: substrate
# artifacts (overlay upper/work, rootfs staging) AND the orchestrator's default state
# root (--state ./scratch/state, --store ./scratch/store.db), so this tree is routinely
# deleted to reset local state. Anything under it that took work to produce must be
# copied OUT before such a reset.
/scratch/
/test/rootfs/
/.spike/

# agent tooling state — worktrees live under here as nested checkouts, and a
# stray `git add -A` otherwise commits them as gitlinks
/.claude/

# editor / OS
.DS_Store

# build artifacts from `go build ./cmd/...` without -o — one line per cmd/, because
# the name is the package name and an unlisted one lands untracked at the repo root
/sandboxd
/orchestrator
/khora
/gateway
/openapigen

# Keep an obsolete local transcript from being added by accident. Substrate results belong
# in the reviewing PR; they are not generated product files.
/.substrate-run.log
